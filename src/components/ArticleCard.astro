---
/* Tarjeta de artículo. variant 'large' (reciente/hero) o 'small' (rejilla).
   eager=true para la imagen LCP (tarjeta grande de la home). */
import CategoryBadge from './CategoryBadge.astro';
import ReadingTime from './ReadingTime.astro';
import { getArticleUrl } from '../config/categories';

interface Props {
  section: string;
  slug: string;
  title: string;
  description?: string;
  heroImage: string;
  heroImageAlt: string;
  pubDate: Date;
  readingTime?: number;
  variant?: 'large' | 'small';
  eager?: boolean;
}

const {
  section, slug, title, description, heroImage, heroImageAlt,
  pubDate, readingTime, variant = 'small', eager = false,
} = Astro.props;

const url = getArticleUrl(section, slug);
const dateLabel = new Intl.DateTimeFormat('es-MX', {
  day: 'numeric', month: 'short', year: 'numeric',
}).format(pubDate);
---
<article class:list={['card', variant]}>
  <a class="card__media" href={url} tabindex="-1" aria-hidden="true">
    <img
      src={heroImage}
      alt={heroImageAlt}
      width="1200"
      height="675"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  </a>
  <div class="card__body">
    <CategoryBadge section={section} size={variant === 'large' ? 'md' : 'sm'} />
    <h3 class="card__title">
      <a href={url}>{title}</a>
    </h3>
    {variant === 'large' && description && (
      <p class="card__desc">{description}</p>
    )}
    <div class="card__meta">
      <time datetime={pubDate.toISOString()}>{dateLabel}</time>
      {readingTime && <span aria-hidden="true">·</span>}
      <ReadingTime minutes={readingTime} />
    </div>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: var(--space-3); }
  .card__media {
    display: block; overflow: hidden; border-radius: 8px;
    background: #ededed; aspect-ratio: 16 / 9;
  }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .card:hover .card__media img { transform: scale(1.03); }

  .card__title {
    font-family: var(--ff-display); font-weight: 700; letter-spacing: -0.02em;
    line-height: 1.18;
  }
  .card__title a { transition: opacity 0.15s ease; }
  .card__title a:hover { opacity: 0.7; }

  .card__desc {
    font-family: var(--ff-body), Georgia, serif;
    color: var(--color-fg-muted); line-height: 1.55;
  }
  .card__meta {
    display: flex; align-items: center; gap: var(--space-2);
    font-family: var(--ff-mono); font-size: 0.72rem; color: var(--color-fg-subtle);
  }
  .card__meta time { font-size: 0.72rem; }

  /* Tamaños por variante */
  .small .card__title { font-size: 1.05rem; }
  .large .card__title { font-size: clamp(1.6rem, 4.5vw, 2.4rem); }
  .large .card__desc { font-size: 1.0625rem; margin-top: var(--space-1); }

  @media (min-width: 1024px) {
    .large { gap: var(--space-4); }
  }
</style>
