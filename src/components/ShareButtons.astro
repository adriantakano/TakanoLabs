---
/* Botones de compartir. Sin framework: enlaces nativos + copiar enlace (script mínimo). */
import { SITE } from '../config/site';

interface Props {
  url: string;     // ruta relativa del artículo, p.ej. /social/slug/
  title: string;
}
const { url, title } = Astro.props;
const absolute = new URL(url, SITE.url).href;
const t = encodeURIComponent(title);
const u = encodeURIComponent(absolute);

const xUrl = `https://twitter.com/intent/tweet?text=${t}&url=${u}`;
const waUrl = `https://wa.me/?text=${t}%20${u}`;
const liUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${u}`;
---
<div class="share" data-share-url={absolute}>
  <span class="share__label">Compartir</span>
  <div class="share__btns">
    <a class="share__btn" href={xUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en X">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.656l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>
    </a>
    <a class="share__btn" href={waUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en WhatsApp">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.987-1.207zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.148-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
    </a>
    <a class="share__btn" href={liUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en LinkedIn">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
    </a>
    <button class="share__btn share__copy" type="button" aria-label="Copiar enlace">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      <span class="share__copied" aria-live="polite"></span>
    </button>
  </div>
</div>

<style>
  .share {
    display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap;
    max-width: var(--content-max); margin-inline: auto;
    padding-block: var(--space-6); margin-block: var(--space-8);
    border-block: 1px solid var(--color-border);
  }
  .share__label {
    font-family: var(--ff-mono); font-size: 0.72rem; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-fg-subtle);
  }
  .share__btns { display: flex; gap: var(--space-2); }
  .share__btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 999px;
    border: 1px solid var(--color-border); background: var(--color-bg);
    color: var(--color-fg); transition: background 0.15s ease, color 0.15s ease;
    position: relative;
  }
  .share__btn:hover { background: var(--color-fg); color: var(--color-bg); }
  .share__copied {
    position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%);
    font-family: var(--ff-mono); font-size: 0.65rem; white-space: nowrap;
    color: var(--color-fg); opacity: 0; transition: opacity 0.15s ease;
  }
  .share__copied[data-show='true'] { opacity: 1; }
</style>

<script>
  document.querySelectorAll('.share').forEach((el) => {
    const url = el.getAttribute('data-share-url') || '';
    const btn = el.querySelector('.share__copy');
    const msg = el.querySelector('.share__copied');
    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        if (msg) {
          msg.textContent = '¡Copiado!';
          msg.setAttribute('data-show', 'true');
          setTimeout(() => msg.setAttribute('data-show', 'false'), 1800);
        }
      } catch {
        /* clipboard no disponible: no hacemos nada */
      }
    });
  });
</script>
