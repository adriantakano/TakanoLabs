---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORY_LIST } from '../config/categories';
---
<BaseLayout title="Página no encontrada (404)" description="La página que buscas no existe." robots="noindex, follow">
  <div class="container nf">
    <p class="nf__code">404</p>
    <h1 class="nf__title">Esta página no existe</h1>
    <p class="nf__text">Quizá el enlace cambió o el contenido se movió. Explora las secciones:</p>
    <ul class="nf__cats" role="list">
      {CATEGORY_LIST.map((c) => (
        <li><a href={`/${c.segment}`} style={`--cat:${c.color}`}>{c.name}</a></li>
      ))}
    </ul>
    <p class="nf__home"><a href="/">← Volver al inicio</a></p>
  </div>
</BaseLayout>

<style>
  .nf { padding-block: var(--space-16); text-align: center; max-width: 40rem; }
  .nf__code { font-family: var(--ff-mono); font-size: 1rem; color: var(--color-fg-subtle); letter-spacing: 0.1em; }
  .nf__title {
    font-family: var(--ff-display); font-weight: 700;
    font-size: clamp(1.8rem, 6vw, 2.6rem); letter-spacing: -0.02em; margin-block: var(--space-2) var(--space-4);
  }
  .nf__text { font-family: var(--ff-body), Georgia, serif; color: var(--color-fg-muted); font-size: 1.1rem; }
  .nf__cats { display: flex; gap: var(--space-6); justify-content: center; flex-wrap: wrap; margin-block: var(--space-8); }
  .nf__cats a { font-family: var(--ff-display); font-weight: 700; color: var(--cat); }
  .nf__home a { font-family: var(--ff-mono); font-size: 0.85rem; text-decoration: underline; text-underline-offset: 3px; }
</style>
