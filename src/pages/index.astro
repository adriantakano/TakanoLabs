---
/* Home editorial. Escritorio: tarjeta grande (reciente) izq + rejilla "más leídos"
   der (estilo The Verge). Móvil: apilado. El widget dinámico "Más leídos"
   (fetch /api/most-read) se conecta en la Fase 3; aquí queda el fallback estático. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MostRead from '../components/MostRead.astro';
import NewsletterInline from '../components/NewsletterInline.astro';
import { SITE } from '../config/site';

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = all.find((p) => p.data.featured) ?? all[0];

// "Últimos artículos": los más recientes de todas las secciones, sin repetir el destacado.
const latest = all.filter((p) => p.id !== featured?.id).slice(0, 6);
---
<BaseLayout
  title={`${SITE.name} — Blog`}
  description={SITE.description}
  ogImage={SITE.defaultOgImage}
>
  <div class="container home">
    {featured ? (
      <section class="home__lead" aria-label="Artículo reciente">
        <ArticleCard
          section={featured.data.section}
          slug={featured.data.slug}
          title={featured.data.title}
          description={featured.data.description}
          heroImage={featured.data.heroImage}
          heroImageAlt={featured.data.heroImageAlt}
          pubDate={featured.data.pubDate}
          readingTime={featured.data.readingTime}
          variant="large"
          eager={true}
        />
      </section>

      <aside class="home__aside">
        <MostRead excludeSlug={featured?.data.slug} />
      </aside>
    ) : (
      <p class="home__empty">Pronto publicaremos los primeros artículos.</p>
    )}
  </div>

  {latest.length > 0 && (
    <section class="container latest" aria-labelledby="latest-title">
      <h2 id="latest-title" class="latest__title">Últimos artículos</h2>
      <ul class="latest__grid" role="list">
        {latest.map((post) => (
          <li>
            <ArticleCard
              section={post.data.section}
              slug={post.data.slug}
              title={post.data.title}
              description={post.data.description}
              heroImage={post.data.heroImage}
              heroImageAlt={post.data.heroImageAlt}
              pubDate={post.data.pubDate}
              readingTime={post.data.readingTime}
              variant="small"
            />
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="container">
    <NewsletterInline />
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: var(--space-8) var(--space-8);
    display: grid; gap: var(--space-12);
    grid-template-columns: 1fr;
  }
  .home__section-title {
    font-family: var(--ff-mono); font-size: 0.78rem; font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-fg-subtle);
    padding-bottom: var(--space-3); margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .home__grid { display: grid; gap: var(--space-8); grid-template-columns: 1fr; }
  @media (min-width: 480px) { .home__grid { grid-template-columns: repeat(2, 1fr); } }
  .home__empty { font-family: var(--ff-body), Georgia, serif; color: var(--color-fg-muted); }

  /* Sección "Últimos artículos" (full-width, debajo del hero) */
  .latest {
    padding-block: var(--space-8) var(--space-12);
    border-top: 1px solid var(--color-border);
  }
  .latest__title {
    font-family: var(--ff-mono); font-size: 0.78rem; font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-fg-subtle);
    padding-bottom: var(--space-3); margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }
  .latest__grid { display: grid; gap: var(--space-8); grid-template-columns: 1fr; }
  @media (min-width: 560px) { .latest__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) {
    .latest__grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-12) var(--space-8); }
  }

  /* Escritorio: dos columnas tipo The Verge */
  @media (min-width: 1024px) {
    .home {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-16);
      align-items: start;
      padding-block: var(--space-12) var(--space-8);
    }
    .home__aside { position: sticky; top: 80px; }
    .home__grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-8) var(--space-6); }
  }
</style>
